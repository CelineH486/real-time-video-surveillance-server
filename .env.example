# Copy this file to .env and replace every secret before exposing the VM.
POSTGRES_DB=surveillance
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=replace-with-a-strong-database-password

UDP_ADDRESS=:5000
HTTP_ADDRESS=:8080

# Replace YOUR_VM_EXTERNAL_IP_OR_DNS with your VM external IP or DNS name.
API_PUBLIC_BASE_URL=http://YOUR_VM_EXTERNAL_IP_OR_DNS:8080
STREAM_PUBLIC_BASE_URL=http://YOUR_VM_EXTERNAL_IP_OR_DNS:8889
CORS_ALLOWED_ORIGINS=http://YOUR_VM_EXTERNAL_IP_OR_DNS:8080
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=YOUR_VM_EXTERNAL_IP_OR_DNS
MEDIAMTX_WEBRTC_ALLOW_ORIGINS=*

STREAM_SIGNING_KEY=replace-with-a-long-random-secret
STREAM_PUBLISH_PASSWORD=replace-with-a-truck-publish-password
CAMERA_OFFLINE_TIMEOUT=15s

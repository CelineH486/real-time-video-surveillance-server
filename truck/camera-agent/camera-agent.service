[Unit]
Description=AHD camera auto-detect and stream publisher
After=NetworkManager.service network-online.target
Wants=NetworkManager.service network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/camera-agent.env
ExecStart=/usr/local/bin/camera-agent
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash

set -u
set -o pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ -r /usr/local/lib/vehicle-agent/camera-agent-lib.sh ]]; then
  source /usr/local/lib/vehicle-agent/camera-agent-lib.sh
else
  source "${script_dir}/camera-agent-lib.sh"
fi

retry_seconds="${CAMERA_RETRY_SECONDS:-5}"

log() {
  printf '%s camera-agent: %s\n' "$(date -Iseconds)" "$*"
}

find_camera() {
  if [[ -n "${CAMERA_DEVICE:-}" && -e "${CAMERA_DEVICE}" ]]; then
    printf '%s\n' "${CAMERA_DEVICE}"
    return 0
  fi

  local device
  for device in /dev/v4l/by-id/* /dev/video*; do
    [[ -e "${device}" ]] || continue
    if v4l2-ctl -d "${device}" --all 2>/dev/null | grep -q 'Video Capture' &&
      v4l2-ctl -d "${device}" --list-formats-ext 2>/dev/null |
        grep -q "'${CAMERA_FOURCC:-UYVY}'"; then
      printf '%s\n' "${device}"
      return 0
    fi
  done
  return 1
}

media_server_reachable() {
  local server host_port host port
  server="${CAMERA_MEDIA_SERVER#rtsp://}"
  server="${server%/}"
  host_port="${server%%/*}"
  host="${host_port%%:*}"
  port="${host_port##*:}"
  timeout 3 bash -c "true </dev/tcp/${host}/${port}" >/dev/null 2>&1
}

required=(
  CAMERA_TRUCK_ID
  CAMERA_ID
  CAMERA_MEDIA_SERVER
  CAMERA_PUBLISH_PASSWORD
)

for name in "${required[@]}"; do
  value="${!name:-}"
  if [[ -z "${value}" ]]; then
    log "${name} is required"
    exit 2
  fi
done

if command -v iw >/dev/null 2>&1; then
  iw dev wlan0 set power_save off >/dev/null 2>&1 || true
fi

while true; do
  if ! media_server_reachable; then
    log "media server is unreachable; retrying in ${retry_seconds}s"
    sleep "${retry_seconds}"
    continue
  fi

  device="$(find_camera || true)"
  if [[ -z "${device}" ]]; then
    log "no compatible camera; retrying in ${retry_seconds}s"
    sleep "${retry_seconds}"
    continue
  fi

  server="${CAMERA_MEDIA_SERVER#rtsp://}"
  server="${server%/}"
  base="$(rtsp_base_url "${CAMERA_TRUCK_ID}" "${CAMERA_PUBLISH_PASSWORD}" "${server}" "${CAMERA_ID}")"
  width="${CAMERA_WIDTH:-1920}"
  height="${CAMERA_HEIGHT:-1080}"
  fps="${CAMERA_FPS:-25}"
  fourcc="${CAMERA_FOURCC:-UYVY}"
  pixel_format="${CAMERA_PIXEL_FORMAT:-uyvy422}"

  log "starting ${device}: ${width}x${height} ${fourcc} ${fps}fps"

  gst-launch-1.0 -q \
    v4l2src device="${device}" io-mode=mmap ! \
    video/x-raw,format="${fourcc}",width="${width}",height="${height}",framerate="${fps}/1" ! \
    queue max-size-buffers=2 max-size-bytes=0 max-size-time=0 leaky=downstream ! \
    fdsink fd=1 sync=false |
    ffmpeg -hide_banner -loglevel warning -nostdin \
      -f rawvideo \
      -pixel_format "${pixel_format}" \
      -video_size "${width}x${height}" \
      -framerate "${fps}" \
      -i pipe:0 \
      -filter_complex \
      "[0:v]split=2[main_input][sub_input];[main_input]scale=-2:${CAMERA_MAIN_HEIGHT:-720},fps=${CAMERA_MAIN_FPS:-12}[main];[sub_input]scale=-2:${CAMERA_SUB_HEIGHT:-360},fps=${CAMERA_SUB_FPS:-8}[sub]" \
      -map '[main]' \
      -an \
      -c:v libx264 \
      -preset "${CAMERA_X264_PRESET:-ultrafast}" \
      -tune zerolatency \
      -pix_fmt yuv420p \
      -b:v "${CAMERA_MAIN_BITRATE:-1500k}" \
      -maxrate "${CAMERA_MAIN_BITRATE:-1500k}" \
      -bufsize "${CAMERA_MAIN_BUFFER:-3000k}" \
      -g "${CAMERA_MAIN_GOP:-24}" \
      -keyint_min "${CAMERA_MAIN_GOP:-24}" \
      -sc_threshold 0 \
      -f rtsp \
      -rtsp_transport tcp \
      "${base}/main" \
      -map '[sub]' \
      -an \
      -c:v libx264 \
      -preset "${CAMERA_X264_PRESET:-ultrafast}" \
      -tune zerolatency \
      -pix_fmt yuv420p \
      -b:v "${CAMERA_SUB_BITRATE:-300k}" \
      -maxrate "${CAMERA_SUB_BITRATE:-300k}" \
      -bufsize "${CAMERA_SUB_BUFFER:-600k}" \
      -g "${CAMERA_SUB_GOP:-16}" \
      -keyint_min "${CAMERA_SUB_GOP:-16}" \
      -sc_threshold 0 \
      -f rtsp \
      -rtsp_transport tcp \
      "${base}/sub"

  status=$?
  log "stream stopped with status ${status}; retrying in ${retry_seconds}s"
  sleep "${retry_seconds}"
done

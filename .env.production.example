# Copy to .env.production on the production server. Never commit that file.
POSTGRES_DB=surveillance
POSTGRES_USER=surveillance
POSTGRES_PASSWORD=change-me-use-a-long-random-password

STREAM_SIGNING_KEY=change-me-use-at-least-32-random-bytes
STREAM_PUBLISH_PASSWORD=change-me-use-a-different-random-password

# Replace these example names with the production dashboard and stream names.
API_PUBLIC_BASE_URL=https://monitor.example.com
STREAM_PUBLIC_BASE_URL=https://stream.monitor.example.com
CORS_ALLOWED_ORIGINS=https://monitor.example.com

# Public IP or DNS names advertised to WebRTC clients, comma-separated.
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=stream.monitor.example.com

UDP_ADDRESS=:5000
HTTP_ADDRESS=:8080
PLAYBACK_INTERNAL_BASE_URL=http://mediamtx:9996
MEDIAMTX_API_URL=http://mediamtx:9997
CAMERA_OFFLINE_TIMEOUT=15s

FROM golang:1.26.6-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/local-storage-worker ./cmd/local-storage-worker
COPY storage ./storage
RUN CGO_ENABLED=0 go build -trimpath -o /worker ./cmd/local-storage-worker
FROM alpine:3.22
RUN apk add --no-cache ffmpeg
COPY --from=build /worker /worker
ENTRYPOINT ["/worker"]
